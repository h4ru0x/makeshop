# MakeShop DataIngest
# In AWS, use the private IP of the DB EC2 instance from CloudFormation outputs.

# --- PostgreSQL (user-service) ---
POSTGRES_HOST=CHANGE_ME_DB_PRIVATE_IP
POSTGRES_PORT=5432
POSTGRES_DB=userdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123

# --- MySQL (shop-service) ---
MYSQL_HOST=CHANGE_ME_DB_PRIVATE_IP
MYSQL_PORT=3307
MYSQL_DB=shopdb
MYSQL_USER=admin
MYSQL_PASSWORD=admin123

# --- MongoDB (product-service) ---
MONGO_URI=mongodb://admin:admin123@CHANGE_ME_DB_PRIVATE_IP:27017/productdb?authSource=admin
MONGO_DB=productdb

# --- AWS ---
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_SESSION_TOKEN=CHANGE_ME
AWS_REGION=us-east-1
S3_BUCKET=openstore-ingest-CHANGE_ME_ACCOUNT_ID

# --- Seeder ---
NUM_SHOPS=100
PRODUCTS_PER_SHOP=200
USERS_PER_SHOP=100
